# ── Annual Daylight API Configuration ──────────────────────────────
# Copy this file to .env and adjust values as needed.
# All variables are prefixed with DAYLIGHT_ to avoid collisions.

# Bind address:
#   127.0.0.1  = localhost only (default, safe)
#   0.0.0.0    = open to the local network
DAYLIGHT_HOST=127.0.0.1

# Port the server listens on
DAYLIGHT_PORT=8080

# Auto-reload on code changes (true/false) — handy during development
DAYLIGHT_RELOAD=false

# Uvicorn log level: debug | info | warning | error | critical
DAYLIGHT_LOG_LEVEL=info
